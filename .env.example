# GEMINI_API_KEY: Read by server.ts for Gemini journal lookup and campaign generation.
# If unset, the server still starts. Lookup uses the built-in catalog, and
# campaign generation uses the deterministic template engine.
GEMINI_API_KEY=

# APP_URL: Some hosting platforms inject the public service URL under this name.
# This application does not read APP_URL.
APP_URL=

# NODE_ENV: Optional. Set to production to serve the Vite build from dist/.
# Any other value, including unset, mounts the Vite development middleware.
# The server always listens on port 3000. There is no PORT setting.
# NODE_ENV=development

# CLARIVATE_API_KEY: Server-only key for the Web of Science Journals API.
# Sent as the X-ApiKey header. Never expose it to the browser, logs, or git.
CLARIVATE_API_KEY=

# CLARIVATE_ADMIN_REFRESH_ENABLED: Extra kill switch for
# POST /api/admin/clarivate-metrics/refresh. The route already requires an
# admin session. Set this to false to return 404 even for an admin.
# CLARIVATE_ADMIN_REFRESH_ENABLED=false

# METRICS_STORE: Where Clarivate journal metrics are stored.
# memory (default) — process memory, for local dev and tests
# file — JSON file at METRICS_STORE_PATH, for local dev
# firestore — Cloud Firestore via Application Default Credentials
METRICS_STORE=memory

# FIRESTORE_PROJECT_ID: GCP project for METRICS_STORE=firestore.
# Cloud Run can use GOOGLE_CLOUD_PROJECT instead when that is already set.
FIRESTORE_PROJECT_ID=

# METRICS_STORE_PATH: Optional path used when METRICS_STORE=file.
# METRICS_STORE_PATH=.data/clarivate-metrics.json
