# GEMINI_API_KEY: Read by server.ts for Gemini journal lookup and campaign generation.
# If unset, the server still starts. Lookup uses the built-in catalog, and
# campaign generation uses the deterministic template engine.
GEMINI_API_KEY=

# APP_URL: Public origin with no trailing slash. Required in production.
# Used for OAuth redirect URIs ({APP_URL}/api/auth/callback) and magic links.
APP_URL=http://localhost:3000

# NODE_ENV: Set to production to serve dist/ and to disable the dev bypass.
# Any other value, including unset, mounts the Vite development middleware.
# The server always listens on port 3000. There is no PORT setting.
# NODE_ENV=development

# --- Authentication (see README, Authentication) ---
# Current provider. magic_link is the default until Springer Nature IT registers
# an OIDC app. The planned upgrade is AUTH_PROVIDER=oidc. google remains available.
AUTH_PROVIDER=magic_link

# Required in production. At least 32 characters. Signs the session cookie.
# Sessions, magic links, and OAuth state are in-memory until a shared store is plugged in.
# On Cloud Run, set max-instances=1. A restart logs users out.
# AUTH_SESSION_SECRET=

# Comma-separated. Default is springernature.com when unset.
# AUTH_ALLOWED_EMAIL_DOMAINS=springernature.com
# Subdomains are rejected unless listed here AND they sit under an allowed apex.
# AUTH_ALLOWED_EMAIL_SUBDOMAINS=
# Emails allowed to POST /api/cache/clear and /api/cache/refresh/:id
# AUTH_ADMIN_EMAILS=

# Dev bypass. Honored only when NODE_ENV is exactly "development" and this is exactly "true".
# AUTH_DEV_BYPASS=true
# AUTH_DEV_USER_EMAIL=dev.user@springernature.com
# AUTH_DEV_USER_NAME=Development User

# Google OIDC. Redirect URI: {APP_URL}/api/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ISSUER=https://accounts.google.com

# Planned upgrade once Springer Nature IT registers the app. Leave AUTH_PROVIDER=magic_link until then.
# Generic OIDC (Entra, Okta, …). Issuer must match the discovery document.
# OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile

# Magic-link mail. Production needs smtp or http. console is local only and is refused in production.
# SMTP: SMTP_HOST and SMTP_FROM are required. SMTP_PORT defaults to 587.
# SMTP_USER and SMTP_PASS are required when the relay authenticates.
# SMTP_SECURE=true for implicit TLS; port 465 is secure even when this is unset.
# HTTP webhook: AUTH_EMAIL_WEBHOOK_URL is required. AUTH_EMAIL_WEBHOOK_BEARER is optional.
# AUTH_EMAIL_TRANSPORT=smtp
# MAGIC_LINK_TTL_SECONDS=900
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false
# AUTH_EMAIL_WEBHOOK_URL=
# AUTH_EMAIL_WEBHOOK_BEARER=

# Set to true when TLS is terminated by a reverse proxy.
# TRUST_PROXY=true
